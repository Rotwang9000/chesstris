# ─────────────────────────────────────────────────────────────────────────
# Tetches — environment configuration
#
# Copy to `.env` and fill in. Everything here is read at process start via
# `dotenv` (see server.js). Values are grouped by how essential they are.
# Only the keys actually consumed by the code are listed.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────────────

# `production` enables strict CSP, strict CORS, HSTS, the /metrics gate and
# the dev-only static mounts. Anything else (or unset) runs in dev mode.
NODE_ENV=development

# HTTP port the server binds to. Defaults to 3022 if unset. (PORT=0 lets the
# OS pick an ephemeral port — used by integration tests.)
PORT=3022

# ── Production-required ──────────────────────────────────────────────────────

# Comma-separated CORS/Socket.IO origin allowlist. REQUIRED in production —
# requests from origins not on this list are rejected. Localhost is always
# allowed in development regardless of this value.
# e.g. ALLOWED_ORIGIN=https://tetches.com,https://www.tetches.com
ALLOWED_ORIGIN=

# Shared secret gating the admin panel (/admin/advertisers), the advertiser
# admin API, and external /metrics access. If unset in production those
# admin surfaces return 503 and /metrics is loopback-only. Use a long random
# string.
ADMIN_TOKEN=

# Secret used to sign wallet-auth sessions (routes/wallet-auth). Set to a
# long random string in production; a per-boot ephemeral secret is used if
# left blank (sessions won't survive a restart).
WALLET_SESSION_SECRET=

# ── Auth0 (optional — email sign-in is currently feature-flagged off) ────────
# Public SPA settings (NOT secrets; they ship in the client). Auth0 owns all
# email + PII handling. Leave blank to disable sign-in entirely.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Optional: pin a specific Auth0 connection (e.g. "email" for passwordless).
AUTH0_CONNECTION=

# ── Observability (optional) ─────────────────────────────────────────────────

# Sentry error/perf reporting. Leave blank to disable. Traces sample at 10%
# in production, 0% otherwise.
SENTRY_DSN=
# Optional release tag reported to Sentry (e.g. a git sha or version).
SENTRY_RELEASE=

# Pino log level: trace|debug|info|warn|error|fatal.
# Defaults to "debug" in development and "info" in production.
LOG_LEVEL=
